---
/**
 * Screenshot.astro
 *
 * Responsive WebP screenshot served from public/. Each image exists at two
 * widths named `<src>-<width>.webp`; `width` and `height` describe the larger
 * one and reserve the layout box before it loads.
 */
interface Props {
  /** Base-relative path without the width suffix, e.g. "static/editor/tool-brush". */
  src: string;
  widths: [number, number];
  width: number;
  height: number;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { src, widths, width, height, alt, sizes, eager = false, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
const [small, large] = widths;
const url = (w: number) => `${base}${src}-${w}.webp`;
---

<img
  class={className}
  src={url(large)}
  srcset={`${url(small)} ${small}w, ${url(large)} ${large}w`}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
/>
