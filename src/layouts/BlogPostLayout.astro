---
/**
 * BlogPostLayout.astro
 *
 * Editorial article layout matching the blog index: standard page hero
 * (kicker/title/lead), then a hairline-ruled body grid with an uppercase
 * meta rail on the left and the reading column on the right. Related
 * posts reuse the same BlogRow rows as the index.
 */
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogRow from "@/components/BlogRow.astro";
import { formatBlogTag, resolveBlogImage } from "@/utils/blog";

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith("/") ? base.slice(0, -1) : base;

const postImage = resolveBlogImage(base, post.data.image);
const imageAlt = post.data.imageAlt ?? `${post.data.title} preview`;
const description = post.data.description ?? post.data.summary;

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const morePosts = posts.filter((entry) => entry.slug !== post.slug).slice(0, 2);
const breadcrumbs = [
  { name: "Home", url: base },
  { name: "Blog", url: `${cleanBase}/blog/` },
  { name: post.data.title, url: `${cleanBase}/blog/${post.slug}/` },
];
---

<Layout
  title={post.data.title}
  description={description}
  image={postImage}
  imageAlt={imageAlt}
  keywords={post.data.tags}
  section={post.data.category}
  ogType="article"
  publishedDate={post.data.date}
  modifiedDate={post.data.updatedDate ?? post.data.date}
  breadcrumbs={breadcrumbs}
>
  <section class="blog-post-page">
    <div class="container content-frame px-4 py-5">
      <article class="blog-post">
        <header class="shell blog-post__hero">
          <a href={`${cleanBase}/blog/`} class="blog-post__back">
            <span aria-hidden="true">←</span>
            All posts
          </a>
          <p class="kicker">{post.data.category}</p>
          <h1 class="page-hero__title blog-post__title">{post.data.title}</h1>
          <p class="page-hero__lead blog-post__summary">{post.data.summary}</p>
        </header>

        <div class="blog-post__body">
          <aside class="blog-post__meta" aria-label="Post details">
            <div class="blog-post__meta-group">
              <span class="blog-post__meta-label">Published</span>
              <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
            </div>
            {
              post.data.updatedDate && (
                <div class="blog-post__meta-group">
                  <span class="blog-post__meta-label">Updated</span>
                  <time datetime={post.data.updatedDate.toISOString()}>
                    {dateFormatter.format(post.data.updatedDate)}
                  </time>
                </div>
              )
            }
            <div class="blog-post__meta-group">
              <span class="blog-post__meta-label">By</span>
              <span class="blog-post__meta-author">{post.data.author}</span>
            </div>
          </aside>

          <div class="blog-post__article">
            {
              post.data.showHeroImage && (
                <figure class="blog-post__figure">
                  <img src={postImage} alt={imageAlt} loading="eager" />
                </figure>
              )
            }

            <div class="blog-post__content prose">
              <slot />
            </div>

            {
              post.data.tags.length > 0 && (
                <footer class="blog-post__footer">
                  <ul class="blog-post__tags" aria-label="Post tags">
                    {post.data.tags.map((tag) => (
                      <li class="pill pill--tag">{formatBlogTag(tag)}</li>
                    ))}
                  </ul>
                </footer>
              )
            }
          </div>
        </div>
      </article>

      {
        morePosts.length > 0 && (
          <aside class="blog-post__more" aria-labelledby="more-posts-heading">
            <div class="section-head">
              <div>
                <p class="kicker mb-2">Keep reading</p>
                <h2 id="more-posts-heading" class="section-title">
                  More from the blog
                </h2>
              </div>
              <a href={`${cleanBase}/blog/`} class="section-link">
                All posts
              </a>
            </div>

            <div class="blog-post__more-list">
              {morePosts.map((entry) => (
                <BlogRow post={entry} headingLevel="h3" />
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .blog-post-page {
    background: var(--page-bg);
  }

  /* --- Header: standard page-hero recipe --- */

  .blog-post__hero {
    padding-bottom: clamp(1.4rem, 2.5vw, 2rem);
  }

  .blog-post__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--color-primary-link);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-post__back:hover {
    color: var(--color-primary-link-hover);
  }

  .blog-post__title {
    margin: 0 0 1.1rem;
    max-width: 24ch;
  }

  .blog-post__summary {
    max-width: 42rem;
  }

  /* --- Body: hairline rule, meta rail | reading column (same grid family
     as the index rows: 11rem rail + fluid copy) --- */

  .blog-post__body {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: clamp(1.2rem, 2.6vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .blog-post__meta {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .blog-post__meta-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .blog-post__meta-label {
    color: var(--color-accent-warm);
  }

  /* --- Reading column --- */

  .blog-post__article {
    max-width: 42rem;
    min-width: 0;
  }

  .blog-post__figure {
    margin: 0 0 clamp(1.8rem, 3.5vw, 2.4rem);
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-subtle);
    background: #101828;
  }

  .blog-post__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .blog-post__content {
    --prose-body-size: 1.05rem;
  }

  .blog-post__footer {
    margin-top: 2.2rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* --- Related posts --- */

  .blog-post__more {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .blog-post__more-list {
    display: grid;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  /* --- Responsive --- */

  @media (max-width: 991.98px) {
    .blog-post__body {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.2rem;
    }

    .blog-post__meta {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.8rem 2rem;
    }

    .blog-post__article {
      max-width: 46rem;
    }
  }

  @media (max-width: 767.98px) {
    .blog-post__title {
      max-width: none;
    }
  }
</style>
