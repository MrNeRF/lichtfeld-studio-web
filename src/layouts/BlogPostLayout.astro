---
/**
 * BlogPostLayout.astro
 *
 * Classic centered article layout: one reading column (~44rem) shared by
 * the header, media, and body so the whole post sits on a single axis.
 * Kinship with the blog index comes from the shared kicker/hairline/meta
 * typography and the BlogRow rows in "More from the blog".
 */
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogRow from "@/components/BlogRow.astro";
import { formatBlogTag, resolveBlogImage } from "@/utils/blog";

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith("/") ? base.slice(0, -1) : base;

const postImage = resolveBlogImage(base, post.data.image);
const imageAlt = post.data.imageAlt ?? `${post.data.title} preview`;
const description = post.data.description ?? post.data.summary;

const dateFormatter = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const morePosts = posts.filter((entry) => entry.slug !== post.slug).slice(0, 2);
const breadcrumbs = [
  { name: "Home", url: base },
  { name: "Blog", url: `${cleanBase}/blog/` },
  { name: post.data.title, url: `${cleanBase}/blog/${post.slug}/` },
];
---

<Layout
  title={post.data.title}
  description={description}
  image={postImage}
  imageAlt={imageAlt}
  keywords={post.data.tags}
  section={post.data.category}
  ogType="article"
  publishedDate={post.data.date}
  modifiedDate={post.data.updatedDate ?? post.data.date}
  breadcrumbs={breadcrumbs}
>
  <section class="blog-post-page">
    <div class="container content-frame px-4 py-5">
      <article class="blog-post">
        <header class="shell blog-post__hero">
          <a href={`${cleanBase}/blog/`} class="blog-post__back">
            <span aria-hidden="true">←</span>
            All posts
          </a>
          <p class="kicker">{post.data.category}</p>
          <h1 class="blog-post__title">{post.data.title}</h1>
          <p class="blog-post__summary">{post.data.summary}</p>
          <p class="blog-post__meta">
            <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
            <span class="blog-post__meta-sep" aria-hidden="true">·</span>
            <span>{post.data.author}</span>
            {
              post.data.updatedDate && (
                <>
                  <span class="blog-post__meta-sep" aria-hidden="true">
                    ·
                  </span>
                  <span>Updated {dateFormatter.format(post.data.updatedDate)}</span>
                </>
              )
            }
          </p>
        </header>

        <div class="blog-post__column">
          {
            post.data.showHeroImage && (
              <figure class="blog-post__figure">
                <img src={postImage} alt={imageAlt} loading="eager" />
              </figure>
            )
          }

          <div class="blog-post__content prose">
            <slot />
          </div>

          {
            post.data.tags.length > 0 && (
              <footer class="blog-post__footer">
                <ul class="blog-post__tags" aria-label="Post tags">
                  {post.data.tags.map((tag) => (
                    <li class="pill pill--tag">{formatBlogTag(tag)}</li>
                  ))}
                </ul>
              </footer>
            )
          }
        </div>
      </article>

      {
        morePosts.length > 0 && (
          <aside class="blog-post__more" aria-labelledby="more-posts-heading">
            <div class="section-head">
              <div>
                <p class="kicker mb-2">Keep reading</p>
                <h2 id="more-posts-heading" class="section-title">
                  More from the blog
                </h2>
              </div>
              <a href={`${cleanBase}/blog/`} class="section-link">
                All posts
              </a>
            </div>

            <div class="blog-post__more-list">
              {morePosts.map((entry) => (
                <BlogRow post={entry} headingLevel="h3" />
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .blog-post-page {
    background: var(--page-bg);
  }

  /* One centered axis: header and body share the same 44rem column so the
     title, meta, media, and text all sit on a single left edge. */
  .blog-post__hero,
  .blog-post__column {
    max-width: 44rem;
    margin-inline: auto;
  }

  .blog-post__hero {
    padding-bottom: 0;
  }

  .blog-post__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--color-primary-link);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-post__back:hover {
    color: var(--color-primary-link-hover);
  }

  .blog-post__title {
    margin: 0 0 1rem;
    color: var(--color-heading);
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .blog-post__summary {
    margin: 0;
    color: var(--color-body-strong);
    font-size: 1.13rem;
    line-height: 1.7;
  }

  /* Single hairline closes the header; the same uppercase meta voice as the
     index rows, without boxing it in rules. */
  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 1.6rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .blog-post__meta-sep {
    color: var(--color-border-hover);
  }

  .blog-post__column {
    margin-top: clamp(0.6rem, 1.5vw, 1.2rem);
  }

  .blog-post__figure {
    margin: 0 0 clamp(1.8rem, 3.5vw, 2.4rem);
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-subtle);
    background: #101828;
  }

  .blog-post__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .blog-post__content {
    --prose-body-size: 1.05rem;
  }

  .blog-post__footer {
    margin-top: 2.2rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* --- Related posts (index-style rows at frame width) --- */

  .blog-post__more {
    margin-top: clamp(2.4rem, 5vw, 4rem);
    padding-top: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .blog-post__more-list {
    display: grid;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
</style>
